# AgentBaazar environment. Copy to .env (git-ignored) and fill in.
# Every service here has a no-card free tier. Never paste secrets into chat; paste them here.

# ---- core ----
DATABASE_URL=                      # Neon: neon.tech -> project agentbaazar -> "Connection string" (pooled)
APP_SECRET=                        # run: openssl rand -hex 32
PUBLIC_URL=http://localhost:3000   # Render URL after first deploy
CONSOLE_PASSWORD=change-me
LOG_LEVEL=info

# ---- paypal sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox -> your app) ----
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                 # printed by `pnpm register-webhook` after first deploy
PAYMENT_MODE=authorize             # authorize | capture
WEBHOOK_VERIFY=strict              # strict | skip (dev only)
PAYPAL_MCP_URL=https://mcp.sandbox.paypal.com/http
NEXT_PUBLIC_PAYPAL_CLIENT_ID=      # same as PAYPAL_CLIENT_ID (public, used by the JS SDK v6 button)

# ---- sandbox test accounts (not secrets, but keep here for the demo) ----
SANDBOX_BUYER_EMAIL=               # Testing Tools -> Sandbox Accounts -> Personal (US)
SANDBOX_BUYER_PASSWORD=
SANDBOX_SELLER_EMAIL=               # Testing Tools -> Sandbox Accounts -> Business (US), the app is bound to this one
SANDBOX_SELLER_PASSWORD=

# ---- agentic contract ----
AGENTIC_JWKS_URL=http://localhost:3000/.well-known/jwks.json   # prod: https://www.paypal.ai/.well-known/jwks.json
JWT_ISSUER=http://localhost:3000
STORE_ADMIN_TOKEN=                 # run: openssl rand -hex 16

# ---- llm (free tiers) ----
LLM_PROVIDER=google                # google | groq | github
LLM_BUYER_MODEL=gemini-3.8-flash
LLM_CONSOLE_MODEL=gemini-3.5-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=      # aistudio.google.com -> Get API key (billing OFF)
GROQ_API_KEY=                      # console.groq.com -> API Keys
GITHUB_MODELS_TOKEN=               # github.com -> Settings -> Developer settings -> fine-grained PAT, models:read

# ---- discovery + console ----
CHANNEL3_API_KEY=                  # trychannel3.com/developers, promo PAYPAL-HACKATHON-2026
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY= # ag-grid.com/studio/license-pricing/?tab=trial
