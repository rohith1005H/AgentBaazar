{
  "name": "agentbaazar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "node --env-file=.env --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/seed.ts",
    "import-feed": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/import-feed.ts",
    "register-webhook": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/register-webhook.ts",
    "smoke": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/smoke.ts",
    "db:check": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/db-check.ts",
    "simulate-webhook": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/simulate-webhook.ts"
  },
  "dependencies": {
    "@neon/config": "1.8.3",
    "@neondatabase/serverless": "1.2.0",
    "@paypal/paypal-server-sdk": "2.5.0",
    "drizzle-orm": "0.45.3",
    "jose": "6.2.12",
    "next": "16.3.8",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@11.25.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module"
}
