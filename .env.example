# AgentBaazar environment. Copy to .env (git-ignored) and fill in.
# Every service here has a no-card free tier. Never commit real values.
# Generated secrets can also live in .env.local (git-ignored); both files are loaded.

# ---- core ----
DATABASE_URL=                      # Neon: neon.tech -> your project -> Connect -> connection string
APP_SECRET=                        # openssl rand -hex 32 (encrypts the signing key, signs order links)
PUBLIC_URL=http://localhost:3000   # public base URL (tunnel or deploy URL for webhooks)
STORE_ADMIN_TOKEN=                 # openssl rand -hex 16 (ship / cancel / refund endpoints)
LOG_LEVEL=info

# ---- paypal sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox -> your app) ----
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                 # printed by `pnpm register-webhook`
WEBHOOK_VERIFY=strict              # strict | skip (development only)
WEBHOOK_ACCEPT_SIMULATOR=false     # true only locally, to accept PayPal webhook-simulator events
# PAYPAL_RETURN_URL= / PAYPAL_CANCEL_URL=   optional; default to PUBLIC_URL/paypal/return|cancel
# CHECKOUT_LEASE_MS=180000         how long a checkout owns its charge before a retry may resume it

# ---- cart api auth ----
AGENTIC_JWKS_URL=http://localhost:3000/.well-known/jwks.json   # where Cart API JWT keys are fetched from
JWT_ISSUER=http://localhost:3000   # iss used by the built-in platform when signing
# AGENTIC_ISSUER= / AGENTIC_AUDIENCE=   optional: pin iss / aud on incoming Cart API JWTs

# ---- buyer agent (free tiers, no card) ----
GOOGLE_GENERATIVE_AI_API_KEY=      # aistudio.google.com -> Get API key (billing off)
GROQ_API_KEY=                      # console.groq.com -> API Keys; used when Gemini is busy
# LLM_BUYER_MODEL=gemini-3.8-flash      first choice; falls back to gemini-3.5-flash-lite, then Groq
# LLM_CONSOLE_MODEL=gemini-3.5-flash-lite

# ---- tests ----
# TEST_DATABASE_URL=               # a throwaway database (e.g. a Neon branch) for integration tests
